{
  "schema_version": 1,
  "unknown_fields": "block",
  "fields": {
    "schema_version": {"required": true, "type": "integer", "enum": [1], "default": 1},
    "forge": {"required": true, "type": "string", "enum": ["auto", "github", "gitlab", "none"], "default": "auto"},
    "harness": {"required": true, "type": "string", "enum": ["auto", "claude-code", "codex", "pi"], "default": "auto"},
    "execution_environment": {"required": true, "type": "string", "enum": ["auto", "orca", "native"], "default": "auto"},
    "base_branch": {"required": true, "type": "string", "pattern": "^(auto|[A-Za-z0-9][A-Za-z0-9._/-]{0,127})$", "validation": "git-check-ref-format---branch", "default": "auto"},
    "concurrency": {"required": true, "type": "integer", "minimum": 1, "maximum": 4, "default": 4},
    "worktree_parent": {"required": true, "type": "string", "pattern": "^(auto|[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*)$", "allowed_forms": ["auto", "safe-repository-relative-path"], "forbidden_forms": ["absolute", "home-relative", "parent-traversal"], "default": "auto"},
    "model_profiles": {
      "required": true,
      "type": "object",
      "properties": {
        "frontier": {"required": true, "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$", "default": "auto"},
        "worker": {"required": true, "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$", "default": "auto"},
        "utility": {"required": true, "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$", "default": "auto"}
      }
    },
    "commands": {
      "required": true,
      "type": "object",
      "properties": {
        "format": {"required": true, "type": "token-array", "default": ["auto"]},
        "lint": {"required": true, "type": "token-array", "default": ["auto"]},
        "typecheck": {"required": true, "type": "token-array", "default": ["auto"]},
        "test": {"required": true, "type": "token-array", "default": ["auto"]},
        "build": {"required": true, "type": "token-array", "default": ["auto"]}
      }
    },
    "protected_paths": {"required": true, "type": "path-array", "item_pattern": "^[A-Za-z0-9._/-]+$", "default": []},
    "mandatory_gates": {"required": true, "type": "gate-array", "item_pattern": "^[a-z0-9][a-z0-9-]{0,62}$", "default": ["high-risk-plan", "irreversible-action", "merge", "deploy"]}
  },
  "canonical_mandatory_gates": ["high-risk-plan", "irreversible-action", "merge", "deploy"],
  "retired_gates": {
    "names": ["intent", "spec", "config", "configuration", "approval"],
    "effect": "block-with-migration"
  },
  "extra_gates": "allowed",
  "command_paths": "must-exist-or-be-auto",
  "accepted_yaml_forms": {
    "mapping": "two-space-indented-block",
    "scalars": "plain-unquoted-single-line",
    "token_arrays": "inline-comma-separated-plain-scalars",
    "path_and_gate_arrays": "empty-inline-or-two-space-block-list",
    "aliases_anchors_tags_and_merge_keys": "block",
    "duplicate_mapping_keys": "block"
  },
  "command_policy": {
    "fail_closed": true,
    "token_pattern": "^[^[:space:],]+$",
    "authority_bearing_executables": ["git", "gh", "glab", "terraform"],
    "authority_bearing_executable_positions": "any",
    "blocked_launcher_executables": ["xcrun"],
    "blocked_launcher_executables_exhaustive": false,
    "read_only_control_cli_allowlist": [],
    "forbidden_token_pattern": "([$][(]|`|&&|[|][|]|[;<>]|(^|[^|])[|]([^|]|$))",
    "shell_evaluation_prefixes": [
      ["sh", "-c"], ["sh", "--command"],
      ["bash", "-c"], ["bash", "--command"],
      ["dash", "-c"], ["zsh", "-c"],
      ["env", "sh", "-c"], ["env", "bash", "-c"],
      ["env", "dash", "-c"], ["env", "zsh", "-c"]
    ],
    "disallowed_mutation_prefixes": [
      ["eval"], ["rm"], ["rmdir"], ["dd"], ["mkfs"], ["shutdown"], ["reboot"],
      ["sudo"], ["env"], ["command"], ["nice"], ["nohup"], ["timeout"], ["xargs"],
      ["git", "add"], ["git", "am"], ["git", "apply"], ["git", "branch"],
      ["git", "checkout"], ["git", "cherry-pick"], ["git", "clean"],
      ["git", "commit"], ["git", "merge"], ["git", "push"], ["git", "rebase"],
      ["git", "reset"], ["git", "restore"], ["git", "switch"], ["git", "tag"],
      ["gh", "issue", "close"], ["gh", "issue", "comment"], ["gh", "issue", "create"], ["gh", "issue", "edit"],
      ["gh", "pr", "close"], ["gh", "pr", "comment"], ["gh", "pr", "create"], ["gh", "pr", "edit"], ["gh", "pr", "merge"], ["gh", "pr", "review"],
      ["gh", "release", "create"], ["gh", "release", "delete"], ["gh", "release", "upload"], ["gh", "repo", "delete"],
      ["glab", "issue", "close"], ["glab", "issue", "create"], ["glab", "issue", "note"], ["glab", "issue", "update"],
      ["glab", "mr", "approve"], ["glab", "mr", "close"], ["glab", "mr", "create"], ["glab", "mr", "merge"], ["glab", "mr", "note"], ["glab", "mr", "update"],
      ["glab", "release", "create"], ["glab", "release", "delete"], ["glab", "release", "upload"],
      ["kubectl", "apply"], ["kubectl", "delete"], ["kubectl", "patch"], ["kubectl", "replace"], ["kubectl", "scale"],
      ["terraform", "apply"], ["terraform", "destroy"], ["terraform", "import"],
      ["helm", "install"], ["helm", "uninstall"], ["helm", "upgrade"],
      ["docker", "push"], ["npm", "publish"], ["cargo", "publish"]
    ]
  }
}
