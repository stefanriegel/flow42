{
  "schema_version": 1,
  "levels": ["low", "medium", "high", "critical"],
  "baseline_checks": ["secrets", "dependencies", "static-analysis"],
  "behavior_change_evidence": ["observed-red", "observed-green"],
  "high_risk_gates": ["plan-approval", "independent-verification"],
  "security_triggers": [
    "authentication",
    "permissions",
    "sensitive-data",
    "networking",
    "payments",
    "infrastructure",
    "production-configuration"
  ],
  "security_gates": ["threat-model", "independent-security-review"],
  "human_approval": {
    "accountable_approvers_per_gate": 1,
    "second_human_required": false
  },
  "independent_review": {
    "implementer_may_review": false,
    "receipt_schema_version": 1,
    "issuer_kinds": ["authenticated-forge", "trusted-orchestrator", "local-independent-pass"],
    "strongest_available_issuer_required": true,
    "fallback_when_no_distinct_forge_reviewer": "local-independent-pass-receipt",
    "receipt_neutral_paths": ["evidence.md", "decisions.md", "history.jsonl", "status.yml"],
    "grants_human_approval": false
  },
  "automatic_review_limit": 2
}
