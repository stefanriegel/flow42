{
  "schema_version": 1,
  "levels": ["low", "medium", "high", "critical"],
  "baseline_checks": ["secrets", "dependencies", "static-analysis"],
  "behavior_change_evidence": ["observed-red", "observed-green"],
  "high_risk_gates": ["high-risk-plan", "independent-verification"],
  "gate_mapping": {
    "high-risk-plan": {"workflow_gate": "high-risk-plan", "configuration_gate": "high-risk-plan", "kind": "human-confirmation"},
    "independent-verification": {"workflow_gate": "verification-passed", "kind": "technical-control"}
  },
  "security_triggers": [
    "authentication",
    "permissions",
    "sensitive-data",
    "networking",
    "payments",
    "infrastructure",
    "production-configuration"
  ],
  "security_gates": ["threat-model", "independent-security-review"],
  "human_approval": {
    "accountable_approvers_per_gate": 1,
    "second_human_required": false
  },
  "independent_review": {
    "implementer_may_review": false,
    "receipt_schema_version": 2,
    "receipt_schema_migration": {"from_version": 1, "accept_previous": false, "action": "rerun-and-reissue-independent-review"},
    "review_kinds": ["correctness", "security"],
    "review_kind_gates": {"correctness": "independent-verification", "security": "independent-security-review"},
    "issuer_kinds": ["authenticated-forge", "trusted-orchestrator", "local-independent-pass"],
    "strongest_available_issuer_required": true,
    "local_fallback_tier": "lower",
    "fallback_when_no_distinct_forge_reviewer": "resolved-distinct-local-session-receipt",
    "review_kind_minimum_checks": {
      "correctness": ["acceptance-criteria", "baseline-checks", "configured-repository-gates", "independent-verification"],
      "security": ["threat-model", "baseline-checks", "configured-repository-security-gates", "independent-security-review"]
    },
    "receipt_required_fields": ["schema_version", "review_kind", "issuer_kind", "issuer_receipt_ref", "repository_id", "work_id", "baseline_head", "reviewed_head", "scope_digest", "diff_digest", "review_subject", "reviewer_principal", "reviewer_role", "dispatch_or_session_ref", "implementer", "verdict", "checks", "artifact_ref", "artifact_digest", "recorded_at"],
    "subject_derivation": {
      "repository_id": "normalized-origin-remote",
      "work_id": "exact-work-item-directory",
      "baseline_head": "git-rev-parse-verify",
      "reviewed_head": "git-rev-parse-verify",
      "scope_digest": "sha256-canonical-ordered-reviewed-path-set",
      "diff_digest": "sha256-nul-safe-no-renames-baseline-to-head-path-content-diff",
      "review_subject": "caller-expected-subject"
    },
    "diff_producer_status": {
      "applies_to": ["receipt-neutral-diff-validation", "diff-digest-derivation"],
      "git_exit_zero_required": true,
      "complete_nul_output_required": true,
      "downstream_success_may_mask_failure": false
    },
    "nul_detection": {
      "applies_to": ["evidence-section-extraction", "status-yaml-parsing"],
      "method": "nul-stripped-copy-and-byte-compare",
      "producer_exit_zero_required": true,
      "reject_before_interpretation": true
    },
    "review_expectation_derivation": {
      "review_kind": "caller-required-review-kind",
      "checks": "caller-required-exact-canonical-ordered-check-array-containing-policy-minimums",
      "artifact_ref": "caller-expected-evidence-section-in-exact-work-item",
      "artifact_digest": "sha256-exact-persisted-evidence-section-bytes"
    },
    "artifact_section_format": {
      "evidence_path": "repository-root/.flow42/<work-id>/evidence.md",
      "begin_marker": "<!-- flow42-review-section:<section-id>:begin -->",
      "end_marker": "<!-- flow42-review-section:<section-id>:end -->",
      "marker_cardinality": "exactly-one-ordered-pair",
      "digest_bytes": "exact-bytes-strictly-between-marker-lines-with-lf-line-terminators",
      "nul_bytes": "reject-before-marker-extraction",
      "links": "reject"
    },
    "authenticated_derivation": {
      "recorded_at": "issuer-authenticated-record-time-or-resolver-observed-distinct-local-session-time"
    },
    "receipt_neutral_paths": ["evidence.md", "decisions.md", "history.jsonl", "status.yml"],
    "status_neutral_fields": ["stage", "state_revision", "updated_at", "blockers", "resume_stage", "ci_state", "next_actions"],
    "forge_link_storage": "evidence.md-non-authoritative-observation",
    "forge_link_authority": {
      "source": "live-authenticated-cli-readback",
      "required_bindings": ["provider", "repository_id", "request_id", "canonical_url", "source_branch", "pushed_head", "reviewed_head", "recorded_at"],
      "persisted_observation_is_authority": false
    },
    "status_required_fields": ["schema_version", "work_id", "title", "work_type", "stage", "risk", "state_revision", "created_at", "updated_at", "review_loops", "blockers", "resume_stage", "forge_item", "change_request", "ci_state", "next_actions"],
    "status_yaml_subset": {
      "mapping": "top-level-scalars-and-inline-string-sequences",
      "duplicate_keys": "reject",
      "quoted_keys": "reject",
      "unknown_keys": "reject",
      "unsupported_constructs": "reject",
      "nul_bytes": "reject-before-parsing",
      "canonicalization": {
        "quoted_scalar": "unquote-without-escapes",
        "quoted_scalar_escapes": "reject",
        "plain_scalar": "preserve",
        "inline_string_sequence": "remove-insignificant-whitespace",
        "field_order": "status_required_fields",
        "comparison": "canonical-key-value"
      },
      "required_fields": ["schema_version", "work_id", "title", "work_type", "stage", "risk", "state_revision", "created_at", "updated_at", "review_loops", "blockers", "resume_stage", "forge_item", "change_request", "ci_state", "next_actions"],
      "change_request_policy": "reserved-empty-for-schema-compatibility",
      "change_request_pattern": "^$"
    },
    "issuer_resolution": {
      "fail_closed": true,
      "required_for": ["authenticated-forge", "trusted-orchestrator", "local-independent-pass"],
      "resolver_must_be_independent": true,
      "resolver_result_schema_version": 2,
      "resolver_result_requirements": ["resolved", "resolver-independent", "issuer-authenticated-or-local-distinct-session"],
      "authenticated_issuer_kinds": ["authenticated-forge", "trusted-orchestrator"],
      "local_fallback_requirements": ["authenticated-false", "distinct-session-true", "resolver-observed-recorded-at"],
      "binding_fields": ["review_kind", "issuer_kind", "issuer_receipt_ref", "repository_id", "work_id", "baseline_head", "reviewed_head", "scope_digest", "diff_digest", "review_subject", "reviewer_principal", "reviewer_role", "dispatch_or_session_ref", "implementer", "verdict", "checks", "artifact_ref", "artifact_digest", "recorded_at"]
    },
    "grants_human_approval": false
  },
  "automatic_review_limit": 2
}
