{
  "schema_version": 1,
  "stages": [
    "draft-intent",
    "intent-gate",
    "drafting-spec",
    "spec-gate",
    "planning",
    "plan-gate",
    "building",
    "verifying",
    "pr-ready",
    "ci-running",
    "ready-for-human",
    "complete"
  ],
  "side_states": ["blocked", "abandoned", "superseded"],
  "transitions": [
    {"from": "draft-intent", "to": "intent-gate"},
    {"from": "intent-gate", "to": "drafting-spec", "gate": "intent"},
    {"from": "drafting-spec", "to": "spec-gate"},
    {"from": "spec-gate", "to": "planning", "gate": "spec"},
    {"from": "planning", "to": "plan-gate", "when": "risk-high-or-critical"},
    {"from": "planning", "to": "building", "when": "risk-low-or-medium"},
    {"from": "plan-gate", "to": "building", "gate": "plan"},
    {"from": "building", "to": "verifying"},
    {"from": "verifying", "to": "pr-ready", "gate": "verification-passed"},
    {"from": "pr-ready", "to": "ci-running", "gate": "change-request-open"},
    {"from": "ci-running", "to": "ready-for-human", "gate": "reviewed-and-ci-green"},
    {"from": "ready-for-human", "to": "complete", "gate": "human-authorized-close"}
  ],
  "side_transitions": [
    {"from": "any-non-final", "to": "blocked", "gate": "reason-and-resume-stage"},
    {"from": "blocked", "to": "recorded-resume-stage", "gate": "blockers-cleared-and-state-valid"},
    {"from": "any-non-final", "to": "abandoned", "gate": "human-authorization"},
    {"from": "any-non-final", "to": "superseded", "gate": "human-authorization-and-replacement-link"}
  ],
  "commands": ["flow", "init", "intent", "spec", "plan", "build", "verify", "pr", "maintain", "status", "resume"],
  "automatic_review_limit": 2,
  "mandatory_gates": ["intent", "spec", "high-risk-plan", "irreversible-action", "merge", "deploy"],
  "terminal_outcome": "ready-for-human",
  "final_states": ["complete", "abandoned", "superseded"]
}
