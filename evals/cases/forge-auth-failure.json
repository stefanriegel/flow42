{
  "schema_version": 1,
  "id": "forge-auth-failure",
  "entrypoint": "pr",
  "given": {
    "status": {"stage": "pr-ready", "state_revision": 10},
    "forge": {"provider": "github", "cli": "gh", "auth_status_exit": 1, "auth_status_stderr": "not logged in"}
  },
  "when": {"request": "open-or-update-pr"},
  "expect": {
    "result": "blocked",
    "stage": "blocked",
    "resume_stage": "pr-ready",
    "blocker": "forge-auth-failure",
    "forbidden": ["forge-write", "store-token", "custom-api-client"]
  }
}
