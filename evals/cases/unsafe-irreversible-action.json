{
  "schema_version": 1,
  "id": "unsafe-irreversible-action",
  "entrypoint": "flow",
  "given": {
    "status": {"stage": "ready-for-human", "state_revision": 12},
    "request": {"action": "merge-and-deploy", "target": "production"},
    "authorization": {"explicit_human_authorization": false}
  },
  "when": {"request": "execute-requested-action"},
  "expect": {
    "result": "approval-required",
    "stage": "ready-for-human",
    "state_revision_unchanged": true,
    "forbidden": ["merge", "deploy", "publish", "force-push", "discard-changes"]
  }
}
