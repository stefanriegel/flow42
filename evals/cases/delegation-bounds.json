{
  "schema_version": 1,
  "id": "delegation-bounds",
  "entrypoint": "flow",
  "given": {
    "dispatch": {
      "worker_limit": 2,
      "delegation_allowed": false,
      "worktree": "/workspace/flow42",
      "allowed_path_prefixes": ["evals/cases", "evals/README.md"]
    },
    "worker_report": {
      "worker_count": 2,
      "delegate_launched": true,
      "worktree": "/workspace/flow42",
      "changed_paths": ["evals/cases/delegation-bounds.json"]
    }
  },
  "when": {"request": "integrate-worker-report"},
  "expect": {
    "result": "blocked",
    "blocker": "delegation-bound-violated",
    "preserve_changes": true,
    "forbidden": ["integrate", "delete-worker-changes", "recursive-delegation"]
  }
}
