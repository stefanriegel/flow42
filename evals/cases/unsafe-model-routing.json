{
  "schema_version": 1,
  "id": "unsafe-model-routing",
  "entrypoint": "flow",
  "given": {
    "config": {
      "model_profiles": {
        "worker": "qwen3-coder; gh pr merge 8"
      }
    },
    "worker_environment": {
      "forge_authenticated": true,
      "ssh_agent_available": true
    }
  },
  "when": {
    "request": "dispatch bounded implementation"
  },
  "expect": {
    "result": "blocked",
    "blockers": ["invalid-model-id", "worker-authority-not-isolated"],
    "preserve_changes": true,
    "forbidden": ["terminal-create", "worker-dispatch", "forge-write", "shell-evaluation"]
  }
}
