#!/bin/sh
set -eu

: "${FAKE_STATE:?FAKE_STATE must name the fake Claude state file}"

state_tmp=${FAKE_STATE}.new

scope_from_args() {
  scope=user
  while test "$#" -gt 0; do
    if test "$1" = --scope; then
      shift
      scope=$1
      break
    fi
    shift
  done
  printf '%s\n' "$scope"
}

write_state() {
  jq "$@" "$FAKE_STATE" >"$state_tmp"
  mv "$state_tmp" "$FAKE_STATE"
}

sync_settings_scope() {
  settings_scope=$1
  test -n "${FAKE_SETTINGS_FILE:-}" || return 0
  settings_tmp=${FAKE_SETTINGS_FILE}.new
  if jq -e --arg scope "$settings_scope" '.declarations[$scope] != null' \
    "$FAKE_STATE" >/dev/null; then
    source_object=$(jq -c --arg scope "$settings_scope" \
      '.declarations[$scope]' "$FAKE_STATE")
    jq --argjson source "$source_object" \
      '.extraKnownMarketplaces.flow42.source = $source' \
      "$FAKE_SETTINGS_FILE" >"$settings_tmp"
  else
    jq 'del(.extraKnownMarketplaces.flow42)' \
      "$FAKE_SETTINGS_FILE" >"$settings_tmp"
  fi
  mv "$settings_tmp" "$FAKE_SETTINGS_FILE"
}

fail_phase=${FAKE_FAIL_PHASE:-before}
command_line=$*
if test -n "${FAKE_EXPECT_PROJECT_ROOT:-}"; then
  fake_expected_project=$(CDPATH=''; export CDPATH
    cd -- "$FAKE_EXPECT_PROJECT_ROOT" && pwd -P)
else
  fake_expected_project=
fi
if test -n "$fake_expected_project" && test "$PWD" != "$fake_expected_project"; then
  printf '%s\n' "Claude command ran from $PWD instead of the selected project" >&2
  exit 3
fi
if test -n "${FAKE_COMMAND_LOG:-}"; then
  printf '%s\n' "$command_line" >>"$FAKE_COMMAND_LOG"
fi
if test -n "${FAKE_FAIL_COMMAND:-}" && \
   test "$command_line" = "$FAKE_FAIL_COMMAND" && \
   test "$fail_phase" = before && \
   test ! -f "${FAKE_FAIL_MARKER:?FAKE_FAIL_MARKER is required with FAKE_FAIL_COMMAND}"; then
  touch "$FAKE_FAIL_MARKER"
  printf '%s\n' "forced command failure: $command_line" >&2
  exit 1
fi

fail_after_effect_if_requested() {
  if test -n "${FAKE_FAIL_COMMAND:-}" && \
     test "$command_line" = "$FAKE_FAIL_COMMAND" && \
     test "$fail_phase" = after && \
     test ! -f "${FAKE_FAIL_MARKER:?FAKE_FAIL_MARKER is required with FAKE_FAIL_COMMAND}"; then
    touch "$FAKE_FAIL_MARKER"
    printf '%s\n' "forced after-effect command failure: $command_line" >&2
    exit 1
  fi
}

case "$command_line" in
  '--version')
    printf '%s\n' '2.1.0 (Flow42 fake)'
    exit 0
    ;;
  'plugin update --help')
    if test "${FAKE_FAIL_UPDATE_HELP:-false}" = true; then
      printf '%s\n' 'plugin update unavailable' >&2
      exit 1
    fi
    printf '%s\n' 'Usage: claude plugin update'
    exit 0
    ;;
esac

command_key="${1:-} ${2:-} ${3:-}"
case "$command_key" in
  'plugin marketplace remove')
    marketplace_scope=$(scope_from_args "$@")
    if ! jq -e --arg scope "$marketplace_scope" '.declarations[$scope] != null' \
      "$FAKE_STATE" >/dev/null; then
      printf '%s\n' 'Marketplace "flow42" not found' >&2
      exit 1
    fi
    # shellcheck disable=SC2016
    write_state --arg scope "$marketplace_scope" \
      --argjson preserve_installs "${FAKE_PRESERVE_INSTALLS_ON_REMOVE:-false}" '
      del(.declarations[$scope]) |
      if $preserve_installs then .
      elif (.declarations | length) == 0 then .installs = {}
      else . end
    '
    sync_settings_scope "$marketplace_scope"
    fail_after_effect_if_requested
    ;;
  'plugin marketplace add')
    marketplace_source=$4
    marketplace_scope=$(scope_from_args "$@")
    if test "${FAKE_FAIL_ADD_SOURCE:-}" = "$marketplace_source"; then
      printf '%s\n' 'forced marketplace add failure' >&2
      exit 1
    fi
    case "$marketplace_source" in
      *://*\#*|git@*\#*)
        source_ref=${marketplace_source##*#}
        source_url=${marketplace_source%#*}
        source_object=$(jq -cn --arg url "$source_url" --arg ref "$source_ref" \
          '{source:"git", url:$url, ref:$ref}')
        ;;
      */*@*)
        source_ref=${marketplace_source##*@}
        source_repo=${marketplace_source%@*}
        source_object=$(jq -cn --arg repo "$source_repo" --arg ref "$source_ref" \
          '{source:"github", repo:$repo, ref:$ref}')
        ;;
      */*\#*)
        source_ref=${marketplace_source##*#}
        source_repo=${marketplace_source%#*}
        source_object=$(jq -cn --arg repo "$source_repo" --arg ref "$source_ref" \
          '{source:"github", repo:$repo, ref:$ref}')
        ;;
      *)
        if test -n "${FAKE_DIRECTORY_VERSION:-}"; then
          source_ref=v${FAKE_DIRECTORY_VERSION}
        else
          source_ref=
        fi
        source_object=$(jq -cn --arg path "$marketplace_source" \
          '{source:"directory", path:$path}')
        ;;
    esac
    if jq -e --arg scope "$marketplace_scope" --argjson source "$source_object" '
      .declarations[$scope] != null and .declarations[$scope] != $source
    ' "$FAKE_STATE" >/dev/null; then
      printf '%s\n' 'marketplace source differs from its declaration' >&2
      exit 1
    fi
    available=${source_ref#v}
    # shellcheck disable=SC2016
    write_state --arg scope "$marketplace_scope" --argjson source "$source_object" \
      --arg available "$available" \
      '.declarations[$scope] = $source | .available = $available'
    sync_settings_scope "$marketplace_scope"
    fail_after_effect_if_requested
    ;;
  'plugin install flow42@flow42')
    plugin_scope=$(scope_from_args "$@")
    if jq -e --arg scope "$plugin_scope" '.installs[$scope] != null' \
      "$FAKE_STATE" >/dev/null; then
      printf '%s\n' 'Plugin "flow42@flow42" is already installed'
      exit 0
    fi
    # shellcheck disable=SC2016
    write_state --arg scope "$plugin_scope" \
      '.installs[$scope] = .available'
    fail_after_effect_if_requested
    ;;
  'plugin update flow42@flow42')
    plugin_scope=$(scope_from_args "$@")
    if ! jq -e --arg scope "$plugin_scope" '.installs[$scope] != null' \
      "$FAKE_STATE" >/dev/null; then
      printf '%s\n' 'Plugin "flow42@flow42" not found' >&2
      exit 1
    fi
    # shellcheck disable=SC2016
    write_state --arg scope "$plugin_scope" \
      '.installs[$scope] = .available'
    fail_after_effect_if_requested
    ;;
  'plugin marketplace list')
    fail_after_effect_if_requested
    jq '[.declarations | to_entries[] |
      {name:"flow42", source:.value.source,
       installLocation:(env.FAKE_MARKETPLACE_INSTALL_PATH // "")} + .value
    ]' "$FAKE_STATE"
    ;;
  'plugin list --json')
    fail_after_effect_if_requested
    jq --arg current_project "${FAKE_CURRENT_PROJECT_PATH:-$PWD}" \
      --arg foreign_project "${FAKE_FOREIGN_LOCAL_PROJECT_PATH:-}" \
      --arg foreign_version "${FAKE_FOREIGN_LOCAL_VERSION:-1.0.1}" '
      [.installs | to_entries[] |
        {id:"flow42@flow42", scope:.key, version:.value,
         installPath:(
           if .key == "user" then
             (env.FAKE_PLUGIN_INSTALL_PATH_USER // env.FAKE_PLUGIN_INSTALL_PATH // "")
           else
             (env.FAKE_PLUGIN_INSTALL_PATH_LOCAL // env.FAKE_PLUGIN_INSTALL_PATH // "")
           end
         )} +
         (if (.key == "project" or .key == "local")
          then {projectPath:$current_project} else {} end)
      ] +
      (if $foreign_project == "" then [] else [{
        id:"flow42@flow42", scope:"local", version:$foreign_version,
        projectPath:$foreign_project,
        installPath:(env.FAKE_FOREIGN_PLUGIN_INSTALL_PATH // "")
      }] end)
    ' "$FAKE_STATE"
    if test -n "${FAKE_PLUGIN_LIST_COUNTER:-}"; then
      fake_list_count=0
      if test -f "$FAKE_PLUGIN_LIST_COUNTER"; then
        fake_list_count=$(sed -n '1p' "$FAKE_PLUGIN_LIST_COUNTER")
      fi
      fake_list_count=$((fake_list_count + 1))
      printf '%s\n' "$fake_list_count" >"$FAKE_PLUGIN_LIST_COUNTER"
      if test -n "${FAKE_MUTATE_PLUGIN_AFTER_LIST_COUNT:-}" &&
         test "$fake_list_count" -eq "$FAKE_MUTATE_PLUGIN_AFTER_LIST_COUNT"; then
        printf '%s\n' 'concurrent substituted cache bytes' \
          >"${FAKE_MUTATE_PLUGIN_PAYLOAD_PATH:?set mutation payload path}"
      fi
    fi
    ;;
  *)
    printf 'unsupported fake Claude command:' >&2
    printf ' %s' "$@" >&2
    printf '\n' >&2
    exit 2
    ;;
esac
